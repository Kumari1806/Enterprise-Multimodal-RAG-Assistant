# ─── Google Gemini (Optional — the app also runs in fallback mode) ──────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── Security (REQUIRED in production: set a strong random value) ───────────
# Used to sign authentication tokens. Never commit the real value.
TOKEN_SECRET=change-me-to-a-long-random-secret
TOKEN_TTL_HOURS=8